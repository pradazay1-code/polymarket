# Polymarket uses Polygon. Get a wallet, fund it with USDC.e on Polygon, and approve the CLOB.
# https://docs.polymarket.com/

# Primary account
PRIVATE_KEY=
FUNDER_ADDRESS=

# Optional extra accounts (the video author runs multiple). Leave blank to skip.
PRIVATE_KEY_2=
FUNDER_ADDRESS_2=

PRIVATE_KEY_3=
FUNDER_ADDRESS_3=

PRIVATE_KEY_4=
FUNDER_ADDRESS_4=

# Polymarket endpoints (defaults are usually fine)
CLOB_HOST=https://clob.polymarket.com
GAMMA_HOST=https://gamma-api.polymarket.com
CHAIN_ID=137

# Logging
LOG_LEVEL=INFO
