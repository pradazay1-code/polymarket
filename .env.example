# Polymarket uses Polygon. Fund a wallet with USDC.e on Polygon.
# https://docs.polymarket.com/

# === SIGNATURE TYPE ===
# 1 = polymarket.com email/Google (Magic) signup. The common case — gasless,
#     allowances managed for you. PRIVATE_KEY is exported from polymarket.com
#     (Settings -> "Export private key"). FUNDER_ADDRESS is the proxy wallet
#     shown on your Deposit page.
# 0 = browser wallet (MetaMask / hardware). PRIVATE_KEY is your EOA key,
#     FUNDER_ADDRESS is the same EOA address. You must approve USDC and
#     ConditionalTokens to the exchange contracts before trading.
# 2 = legacy browser-proxy contract (rare; only set this if you specifically know you have one).
SIGNATURE_TYPE=1

# Primary account
PRIVATE_KEY=
FUNDER_ADDRESS=

# Optional extra accounts — leave blank to skip
PRIVATE_KEY_2=
FUNDER_ADDRESS_2=
SIGNATURE_TYPE_2=1

PRIVATE_KEY_3=
FUNDER_ADDRESS_3=
SIGNATURE_TYPE_3=1

PRIVATE_KEY_4=
FUNDER_ADDRESS_4=
SIGNATURE_TYPE_4=1

# Polymarket endpoints (defaults are fine)
CLOB_HOST=https://clob.polymarket.com
GAMMA_HOST=https://gamma-api.polymarket.com
CHAIN_ID=137

LOG_LEVEL=INFO
